<?xml version="1.0" encoding="UTF-8"?>
<phpunit
  colors="true"
  columns="120">
  <testsuites>
    <testsuite name="Main">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <!-- Coverage is opt-in: run PHPUnit with the coverage driver enabled and ask
       for a report on the command line. A report block here would make every
       plain run ask for a coverage driver (path coverage even needs Xdebug),
       which only produced warnings in CI. -->
  <coverage>
    <include>
      <directory suffix=".php">src</directory>
    </include>
  </coverage>
  <php>
    <ini name="memory_limit" value="-1" />
  </php>
</phpunit>
